# PrescoPad Backend Python Environment Variables Template

PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=PrescoPad
MONGODB_DB_NAME=prescopad

# Auth & Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30

# AI Consultation Transcriber
GROQ_API_KEY=your_groq_api_key_here

# SMS OTP (Twilio or Renflair)
OTP_DEMO_MODE=True
OTP_DEMO_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RENFLAIR_API_KEY=
